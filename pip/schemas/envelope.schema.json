{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pip.local/envelope/1.0.0",
  "title": "PIP CloudEvents 1.0 structured-mode envelope",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "dataschema", "datacontenttype", "storeid", "partitionkey", "data"],
  "additionalProperties": false,
  "properties": {
    "specversion":     {"const": "1.0"},
    "id":              {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "source":          {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/-]+$"},
    "type":            {"type": "string", "maxLength": 128, "pattern": "^com\\.pip\\.[a-z0-9.]+$"},
    "time":            {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "subject":         {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "dataschema":      {"type": "string", "maxLength": 256, "pattern": "^https://schemas\\.pip\\.local/[a-z0-9./-]+$"},
    "datacontenttype": {"const": "application/json"},
    "storeid":         {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "partitionkey":    {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "simrunid":        {"type": "string", "pattern": "^run-[a-f0-9]{12}$"},
    "sequence":        {"type": "string", "pattern": "^[0-9]{1,20}$"},
    "traceparent":     {"type": "string", "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"},
    "tracestate":      {"type": "string", "maxLength": 512},
    "data":            {"type": "object"}
  }
}

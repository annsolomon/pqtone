# Do not copy by hand: `make bootstrap` (or `make all`) generates .env with random secrets.
# Variables it defines:
PIP_PUBLIC_URL=http://localhost:8080
PIP_BIND_ADDR=127.0.0.1
PIP_UID=1000
PIP_GID=1000
POSTGRES_PASSWORD=
PIP_DB_MIGRATOR_PASSWORD=
PIP_DB_APP_PASSWORD=
PIP_DB_READ_PASSWORD=
PIP_KAFKA_ADMIN_PASSWORD=
PIP_KAFKA_EVENTCORE_PASSWORD=
PIP_KAFKA_RULES_PASSWORD=
PIP_KAFKA_SIM_PASSWORD=
KC_ADMIN_PASSWORD=
PIP_OIDC_CLIENT_SECRET=
PIP_SIM_CLIENT_SECRET=
PIP_EDGE_CLIENT_SECRET=
PIP_VIEWER_PASSWORD=
PIP_OPERATOR_PASSWORD=
PIP_REVIEWER_PASSWORD=
PIP_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Keycloak sslRequired: external (default) | none (Codespaces URL mode) | all
PIP_KC_SSL_REQUIRED=external

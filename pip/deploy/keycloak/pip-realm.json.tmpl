{
  "realm": "pip",
  "displayName": "Store operations",
  "enabled": true,
  "sslRequired": "__KC_SSL_REQUIRED__",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR",
    "CODE_TO_TOKEN_ERROR"
  ],
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "See the floor and incidents"
      },
      {
        "name": "operator",
        "description": "Acknowledge incidents"
      },
      {
        "name": "reviewer",
        "description": "Confirm, dismiss and close incidents"
      },
      {
        "name": "admin",
        "description": "Shadow rules, audit log"
      },
      {
        "name": "event-producer",
        "description": "Machine clients allowed to ingest events"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ops-console",
      "name": "Operations console (BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__OIDC_CLIENT_SECRET__",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "__PUBLIC_URL__/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "__PUBLIC_URL__"
      ],
      "rootUrl": "__PUBLIC_URL__",
      "baseUrl": "/",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__PUBLIC_URL__/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles in ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "store-sim",
      "name": "Store simulator (HTTP ingest)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__SIM_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "edge-demo",
      "name": "Demo edge gateway for store-001",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__EDGE_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ],
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Vera",
      "lastName": "Viewer",
      "email": "viewer@pip.local",
      "credentials": [
        {
          "type": "password",
          "value": "__VIEWER_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ]
    },
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Omar",
      "lastName": "Operator",
      "email": "operator@pip.local",
      "credentials": [
        {
          "type": "password",
          "value": "__OPERATOR_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "operator"
      ]
    },
    {
      "username": "reviewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Rita",
      "lastName": "Reviewer",
      "email": "reviewer@pip.local",
      "credentials": [
        {
          "type": "password",
          "value": "__REVIEWER_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "reviewer"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "email": "admin@pip.local",
      "credentials": [
        {
          "type": "password",
          "value": "__ADMIN_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "service-account-store-sim",
      "enabled": true,
      "serviceAccountClientId": "store-sim",
      "realmRoles": [
        "event-producer"
      ]
    },
    {
      "username": "service-account-edge-demo",
      "enabled": true,
      "serviceAccountClientId": "edge-demo",
      "realmRoles": [
        "event-producer"
      ]
    }
  ]
}

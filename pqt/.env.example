# Do not copy by hand: `make bootstrap` (or `make all`) generates .env with random secrets.
# Variables it defines:
PQT_PUBLIC_URL=http://localhost:8080
PQT_BIND_ADDR=127.0.0.1
PQT_UID=1000
PQT_GID=1000
POSTGRES_PASSWORD=
PQT_DB_MIGRATOR_PASSWORD=
PQT_DB_APP_PASSWORD=
PQT_DB_READ_PASSWORD=
PQT_KAFKA_ADMIN_PASSWORD=
PQT_KAFKA_EVENTCORE_PASSWORD=
PQT_KAFKA_RULES_PASSWORD=
PQT_KAFKA_SIM_PASSWORD=
KC_ADMIN_PASSWORD=
PQT_OIDC_CLIENT_SECRET=
PQT_SIM_CLIENT_SECRET=
PQT_EDGE_CLIENT_SECRET=
PQT_VIEWER_PASSWORD=
PQT_OPERATOR_PASSWORD=
PQT_REVIEWER_PASSWORD=
PQT_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Keycloak sslRequired: external (default) | none (Codespaces URL mode) | all
PQT_KC_SSL_REQUIRED=external
